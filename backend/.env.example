# ------------------------------------------------------------------
# Jobsite Management System (JMS) - environment configuration
# Copy this file to `.env` and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# ==================================================================
# DATABASE (Supabase Postgres)  - Supabase Dashboard > Connect
# Precedence: SUPABASE_DB_URL > DATABASE_URL > discrete DB_* fields.
# URL-encode special characters in the password (@ -> %40, # -> %23 ...).
# ==================================================================

# Runtime connection used by the API.
# Transaction pooler (recommended for the app server), port 6543:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler (IPv4, port 5432):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (IPv6 unless IPv4 add-on), port 5432:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Optional: separate URL used ONLY by the Knex CLI (npm run migrate).
# Recommended: session pooler or direct connection (port 5432).
# Falls back to SUPABASE_DB_URL when empty.
SUPABASE_MIGRATION_DB_URL=

# Discrete alternative (used only when no URL is set above).
# Supabase pooler example: host=aws-0-<region>.pooler.supabase.com, port=6543|5432,
# user=postgres.<project-ref>, database=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# --- SSL ---
# Empty = auto (enabled for *.supabase.co / *.supabase.com hosts, off for localhost).
DB_SSL=
# false = encrypt but skip cert-chain verification (Supabase default setup).
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: path to Supabase CA cert (Dashboard > Database > SSL) for strict verification.
DB_SSL_CA_PATH=

# --- Connection pool ---
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000

# ==================================================================
# SUPABASE API (future: Storage for documents, Auth, etc.)
# Dashboard > Project Settings > API
# ==================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS - never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (used in upcoming modules) ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
